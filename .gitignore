__pycache__/
*.pyc

# Volle Entwürfe und Teaser nie öffentlich committen — liegen im privaten
# Actions-Cache (Fortsetzung bei Abbruch), siehe daily.yml
drafts/*
!drafts/.gitkeep
sources/*
!sources/.gitkeep

# Verschlüsselter Cache-Container (nur im Workflow)
.knall-cache/
.pytest_cache/
# Privates Fehler-Archiv (nur verschlüsselt im Actions-Cache)
archiv/
# Artikelseiten (site/<slug>/) baut der Deploy-Schritt frisch aus published/ —
# nicht committen, sonst ändert jeder Lauf tausende Dateien
site/*/
!site/fonts/
